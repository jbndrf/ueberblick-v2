{
  "name": "@ueberblick/builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "description": "Builder: the project-file IDE. Document model in src/doc, shell and lens registry in src/shell, problems in src/problems (docs/08-builder.md).",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck:nogen": "svelte-check --incremental --tsconfig ./tsconfig.json --threshold warning",
    "typecheck": "npm run i18n --silent && npm run typecheck:nogen --silent"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@ueberblick/core": "*",
    "@ueberblick/ui": "*",
    "@xyflow/svelte": "^1.7.0",
    "qrcode-generator": "^2.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.0.0",
    "@inlang/plugin-message-format": "^4.4.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0"
  }
}
