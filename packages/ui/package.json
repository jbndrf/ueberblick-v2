{
  "name": "@ueberblick/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tool-api": "./src/tool-host/api.ts",
    "./tool-testing": "./src/tool-host/testing.ts",
    "./testing": "./src/testing/index.ts",
    "./view-style": "./src/map/view-style.ts",
    "./utils": "./src/utils.ts",
    "./app.css": "./src/app.css",
    "./components/ui/*": "./src/components/ui/*/index.ts",
    "./components/admin": "./src/components/admin/index.ts"
  },
  "sideEffects": false,
  "description": "Design system: tokens, themes, icons and field-proof primitives (Svelte 5).",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "typecheck:nogen": "svelte-check --incremental --tsconfig ./tsconfig.json --threshold warning",
    "typecheck": "npm run i18n --silent && npm run typecheck:nogen --silent"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@tanstack/svelte-virtual": "^3.13.39",
    "@tanstack/table-core": "^8.21.3",
    "@ueberblick/core": "*",
    "bits-ui": "^2.11.5",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "maplibre-gl": "^6.11.2",
    "mode-watcher": "^1.1.0",
    "pmtiles": "^4.5.0",
    "supercluster": "^9.1.0",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.0.0",
    "@inlang/plugin-message-format": "^4.4.4",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/user-event": "^14.5.0",
    "axe-core": "^4.10.0",
    "jsdom": "^26.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0"
  }
}
