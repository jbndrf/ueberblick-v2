{
  "name": "ueberblick",
  "version": "4.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/tools/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "sbom": "node scripts/sbom.mjs",
    "gen:schema": "node schema/gen.mjs",
    "typecheck": "node scripts/ops/steps.mjs --parallel --before typecheck:gen typecheck typecheck:root typecheck:ui typecheck:builder typecheck:bench typecheck:web",
    "typecheck:changed": "node scripts/ops/typecheck-changed.mjs main",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "typecheck:gen": "node scripts/ops/codegen-stamp.mjs",
    "typecheck:ui": "npm run typecheck:nogen --silent -w @ueberblick/ui",
    "typecheck:builder": "npm run typecheck:nogen --silent -w @ueberblick/builder",
    "typecheck:bench": "tsc -p bench/tsconfig.json",
    "typecheck:web": "svelte-check --workspace . --tsconfig apps/web/tsconfig.json --threshold warning",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:journeys": "node scripts/e2e/run.mjs --suite journeys",
    "e2e:main": "node scripts/e2e/main-watch.mjs",
    "e2e:triage": "node scripts/e2e-triage/triage.mjs",
    "ui": "node scripts/ui/ui.mjs",
    "dev": "node scripts/dev/dev.mjs",
    "dev:http": "node scripts/dev/dev.mjs --http",
    "test:dev": "RUN_DEV_SPEC=1 node scripts/ops/vitest-scoped.mjs run scripts/dev/dev.spec.mjs",
    "demo": "node scripts/demo/demo.mjs",
    "journeys": "node scripts/ui/journeys.mjs",
    "lint": "node scripts/ops/steps.mjs lint lint:eslint lint:prettier",
    "lint:eslint": "eslint --concurrency=off --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "lint:prettier": "prettier --check --cache --cache-strategy content --cache-location node_modules/.cache/prettier-lint/cache.json \"packages/**/*.{ts,svelte,json}\" \"apps/**/*.{ts,svelte,json}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,js,cjs,ts}\"",
    "format": "prettier --write --cache --cache-strategy content --cache-location node_modules/.cache/prettier-lint/cache.json \"packages/**/*.{ts,svelte,json}\" \"apps/**/*.{ts,svelte,json}\" \"scripts/**/*.{mjs,ts}\" \"*.{json,js,cjs,ts}\"",
    "glossary": "node scripts/glossary-lint.mjs",
    "lint:ui-strings": "node scripts/ui-strings-lint.mjs",
    "lint:max-lines": "node scripts/ops/max-lines.mjs",
    "messages:sort": "node scripts/messages-sort.mjs",
    "boundaries": "depcruise packages apps/web/src --config .dependency-cruiser.cjs --exclude '(node_modules|reference|dist|\\.svelte-check|\\.planted)'",
    "test": "scripts/ops/check-gate.sh --scoped-after 3 node scripts/ops/vitest-scoped.mjs run",
    "test:golden": "node scripts/ops/vitest-scoped.mjs run fixtures/golden --passWithNoTests",
    "sim": "SIM=1 node scripts/ops/vitest-scoped.mjs run fixtures/golden/simulation/long apps/migrate/src/data/scale.spec.ts packages/builder/src/lenses/yaml/lazy.spec.ts",
    "bench": "node bench/harness/cli.mjs",
    "admin": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/backup/register.mjs packages/server/src/admin/cli.ts",
    "backup:drill": "node --experimental-transform-types --import ./scripts/backup/register.mjs scripts/backup/drill.mjs",
    "backup:restore-folder": "node --experimental-transform-types --import ./scripts/backup/register.mjs scripts/backup/restore.mjs",
    "backup:roundtrip": "node scripts/backup/docker-roundtrip.mjs",
    "backup:journal": "node scripts/backup/journal.mjs",
    "backup:restore": "node --experimental-transform-types --import ./scripts/backup/register.mjs scripts/backup/replay.mjs",
    "backup:manifest": "node scripts/backup/manifest.mjs",
    "bench:test": "node scripts/ops/vitest-scoped.mjs run -c bench/harness/vitest.config.ts",
    "bench:harness": "node scripts/ops/vitest-scoped.mjs run -c bench/harness/vitest.config.ts bench/harness",
    "bench:browser": "node bench/browser/run.mjs",
    "bench:browser:test": "node scripts/ops/vitest-scoped.mjs run -c bench/browser/vitest.config.ts",
    "check:fast": "scripts/ops/check-gate.sh --light npm run check:fast:run",
    "check:fast:scoped": "node scripts/ops/steps.mjs --parallel --fail-fast --before typecheck:gen fast typecheck:changed lint:changed glossary lint:ui-strings lint:max-lines",
    "lint:changed": "node scripts/ops/lint-changed.mjs main",
    "check:fast:run": "node scripts/ops/steps.mjs --parallel --fail-fast --before typecheck:gen fast typecheck lint glossary lint:ui-strings lint:max-lines",
    "deps:install": "scripts/ops/check-gate.sh --light node scripts/ops/deps-install.mjs",
    "check": "scripts/ops/check-gate.sh node scripts/ops/steps.mjs --parallel --fail-fast --before typecheck:gen --after bench:harness check check:fast boundaries test:record",
    "check:changed": "scripts/ops/check-gate.sh node scripts/ops/steps.mjs --parallel --fail-fast --before typecheck:gen changed check:fast:scoped boundaries test:changed",
    "test:record": "node scripts/metrics/test-record.mjs",
    "test:fanout": "node scripts/ops/fanout.mjs",
    "test:changed": "node scripts/metrics/test-record.mjs --changed main --passWithNoTests",
    "metrics": "node scripts/metrics/report.mjs",
    "metrics:selection": "node scripts/metrics/selection.mjs",
    "metrics:rework": "node scripts/metrics/rework.mjs",
    "parity": "node scripts/metrics/parity.mjs",
    "metrics:check-cost": "node scripts/metrics/check-cost.mjs",
    "housekeep": "node scripts/ops/housekeep.mjs"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "^10.3.0",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
