{
  "name": "@ueberblick/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The SvelteKit app (adapter-node): the one server process.",
  "scripts": {
    "i18n": "npm run i18n -w @ueberblick/ui -w @ueberblick/builder -w @ueberblick/tool-chat -w @ueberblick/tool-draw -w @ueberblick/tool-file -w @ueberblick/tool-measure -w @ueberblick/tool-photo -w @ueberblick/tool-search --silent && npm run i18n:own --silent",
    "i18n:own": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/participant/paraglide",
    "prebuild": "npm run i18n --silent",
    "build": "vite build",
    "start": "node build/index.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0",
    "@ueberblick/core": "*",
    "@ueberblick/server": "*",
    "better-sqlite3": "^12.0.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.30.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.1.13",
    "@ueberblick/builder": "*",
    "@ueberblick/ui": "*",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "bits-ui": "^2.11.5",
    "mode-watcher": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0"
  }
}
