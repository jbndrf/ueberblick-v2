# Überblick: Einstellungen / settings
# Kopieren Sie diese Datei nach `.env` und passen Sie wenige Zeilen an: `cp .env.example .env`
# Copy this file to `.env` and edit a few lines: `cp .env.example .env`
# Leere Werte gelten als nicht gesetzt. / An empty value counts as unset.

# --- Adresse / Address ---------------------------------------------------

# Die Adresse, die Leute im Browser öffnen (ohne Pfad). Für Links und QR-Codes. Pflicht.
# The address people open in the browser (no path). Used for links and QR codes. Required.
PUBLIC_URL=https://ueberblick.example.org

# proxy: Ihr HTTPS-Proxy (Traefik, Caddy, nginx, Coolify) steht davor. direct: die App bietet lokales HTTPS selbst an.
# proxy: your HTTPS proxy sits in front. direct: the app serves local HTTPS itself.
HTTPS_MODE=proxy

# Nur direct: IPs oder Namen, unter denen Leute die App öffnen (für das Zertifikat), durch Komma getrennt.
# direct only: the IPs or names people open, for the certificate, comma separated.
LOCAL_HOSTS=

# Nur direct: der HTTPS-Port. / direct only: the HTTPS port.
HTTPS_PORT=8443

# Nur direct: der http-Port, der auf https umleitet (0 = aus). Veröffentlicht wird er nur, wenn Sie in .env die
# Zeile COMPOSE_FILE=docker-compose.yaml:docker-compose.direct.yaml hinzufügen (siehe docs/user/admin/server-install.md).
# direct only: the http port that redirects to https (0 = off). It is published only if you add to .env the
# line COMPOSE_FILE=docker-compose.yaml:docker-compose.direct.yaml (see docs/user/admin/server-install.en.md).
HTTP_PORT=8080

# Nur proxy: IPs oder Netze (CIDR) Ihres Proxys; nur von dort gilt X-Forwarded-*.
# proxy only: IPs or CIDR ranges of your proxy; X-Forwarded-* is trusted only from these.
TRUSTED_PROXIES=

# Der Port auf dem Server, unter dem die App läuft. / The port on the host where the app is reachable.
APP_PORT=3000

# --- Erster Administrator / First admin (nur beim ersten Start / on first start only) ---

# E-Mail und Passwort (mindestens 10 Zeichen) des ersten Administrators.
# E-mail and password (at least 10 characters) of the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# on: Anmeldung zusätzlich mit Code aus einer Authenticator-App. off: nur E-Mail und Passwort.
# on: sign-in also needs a code from an authenticator app. off: e-mail and password only.
ADMIN_TOTP=off

# --- Grenzen / Limits -------------------------------------------------------

# Größter Upload (Fotos, Importe), z. B. 512K, 50M, 1G. / Largest upload (photos, imports).
UPLOAD_LIMIT=50M

# Tage, die eine Teilnehmer-Sitzung gilt; bei jeder Nutzung verlängert.
# Days a participant session lasts; renewed on every use.
SESSION_DAYS_PARTICIPANT=90

# Tage für "angemeldet bleiben" bei Administratoren. / Days for an admin's "stay signed in".
SESSION_DAYS_ADMIN_REMEMBER=30

# --- Datensicherung / Backup (optional) -----------------------------------

# Ein lokaler Ordner (z. B. ein eingehängtes NAS); leer = aus.
# A local folder (e.g. a mounted NAS path); empty = off.
BACKUP_DIR=

# --- Erweitert / Advanced ---------------------------------------------------

# Wie oft (in Sekunden) der Server nach fälligen zeitgesteuerten Regeln sucht; 0 = aus.
# How often (in seconds) the server looks for due timed rules; 0 = off.
TIMERS_INTERVAL_S=30
